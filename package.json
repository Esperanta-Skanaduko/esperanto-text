{
  "name": "esperanto-text",
  "version": "0.1.0",
  "description": "Convert Esperanto text between the x-system, the h-system and real letters (ĉ ĝ ĥ ĵ ŝ ŭ), and type them as you go: a plain function, a DOM helper and a React hook.",
  "keywords": [
    "esperanto",
    "x-system",
    "h-system",
    "transliteration",
    "diacritics",
    "ĉ",
    "input",
    "react"
  ],
  "license": "MIT",
  "author": {
    "name": "Victor Williams",
    "email": "victor.williams.dev@gmail.com",
    "url": "https://github.com/Vaporjawn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Esperanta-Skanaduko/esperanto-text.git"
  },
  "homepage": "https://esperantaskanaduko.com/open-source/esperanto-text/",
  "bugs": "https://github.com/Esperanta-Skanaduko/esperanto-text/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:site": "node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
